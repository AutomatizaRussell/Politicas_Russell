# Names only: the values live in the deployment environment
# (docs/contrato-consentimiento.md §6).

# Public URL of this service, without a trailing slash. Requests and API
# assertions must carry it as their audience.
URL_SERVICIO=

# PostgreSQL connection string.
DATABASE_URL=

# Private JWK (ES256, with kid) that signs the receipts.
# Generate one with: node src/cli.ts generar-llave
RECIBO_LLAVE_PRIVADA=

# Optional JSON array of public JWKs still published after a rotation.
RECIBO_LLAVES_RETIRADAS=

# Optional listening port; 3000 by default.
PUERTO=
